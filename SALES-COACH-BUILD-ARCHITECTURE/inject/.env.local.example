# .env.local.example — copy to `.env.local` at the APP ROOT (C:\Users\johns\IOS-APP\Elostate-Sales-coach\.env.local).
# `.env.local` is gitignored (see the app's .gitignore: `.env*.local`) so real values never get committed.
#
# NOTE: your real .env.local has ALREADY been written for you with the live Elostate values — you do not need to
# fill these in. This example exists so the required vars are documented and recoverable.
#
# EXPO_PUBLIC_ = readable by the app client. The Supabase URL + anon key are PUBLIC BY DESIGN (the anon key is
# meant to ship in clients; Row-Level Security protects the data). NEVER add SUPABASE_SERVICE_ROLE_KEY here — it
# bypasses RLS and must stay on the server only.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_API_BASE=https://elostate.com
