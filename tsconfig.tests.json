{
  // Typechecks the TEST suite, which the app's tsconfig deliberately excludes.
  //
  // WHY IT IS SEPARATE. The app config must describe the app: React Native, no
  // Node globals, no test runner. Folding the tests into it would put `node:fs`
  // and `node:test` in scope for screen code, and the first person to reach for
  // `readFileSync` in a component would get no error until the app crashed on a
  // device.
  //
  // WHY IT EXISTS AT ALL. Without it the tests were never typechecked by
  // anything: `node --test` strips types rather than checking them, and the app
  // config excludes `tests`. Eighty-odd tests were being trusted to guard the
  // build while nothing guarded them. A test asserting against a field that no
  // longer exists still passes — it just stops testing anything.
  //
  // Run by the `pretest` script, so it happens on every `npm test`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  // The env declarations must be listed explicitly: they are what teach TSX that
  // `className` exists on a React Native element, and dropping them makes every
  // styled component in the app look like a type error.
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "SALES-COACH-BUILD-ARCHITECTURE"]
}
