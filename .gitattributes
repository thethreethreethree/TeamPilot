# Auto detect text files and perform LF normalization
* text=auto

# Governing documents are hashed by scripts/tbc/verify-docs.mjs against
# docs/tbc/DOC_MANIFEST.json. Pin them to LF in the working tree on every
# platform so the hash is stable across checkouts — otherwise a fresh Windows
# clone (core.autocrlf=true) checks them out as CRLF and `npm run check` fails
# on a hash mismatch that has nothing to do with a real edit. (AMD-008 install.)
CLAUDE.md text eol=lf
ThinkerThinker.md text eol=lf
