    "lucide-react": "^0.513.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.0.1",
    "docx": "^9.7.1",
    "eslint": "^8",
    "eslint-config-next": "15.3.2",
    "postcss": "^8",
    "supabase": "^2.104.0",
    "tailwindcss": "^3.4.1",
