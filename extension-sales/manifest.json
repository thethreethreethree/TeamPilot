{
  "manifest_version": 3,
  "name": "Sales Coach — coach the sales conversation you're viewing",
  "version": "0.1.0",
  "description": "Sales coaching on the conversation you're viewing: read the room, coach your reply, catch up, and draft the next message.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sales Coach — open the panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://localhost:4321/*", "https://elostate.com/*"]
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:4321/*",
    "https://elostate.com/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ]
}
