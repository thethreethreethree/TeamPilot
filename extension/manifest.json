{
  "manifest_version": 3,
  "name": "C.A.R.E — assist the conversation you're viewing",
  "version": "0.3.0",
  "description": "Summarize, Dissect, Coach, Co-Pilot, and capture conversations (text + media) into your C.A.R.E workspace.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "C.A.R.E — open the panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://localhost:4321/*", "https://elostate.com/*"]
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:4321/*",
    "https://elostate.com/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ]
}
