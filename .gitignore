# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secrets, keys & certificates — defensive net so an accidental `git add` can't leak them
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*credentials*.json
service-account*.json

# Test coverage output (vitest --coverage) — regenerated locally, never committed
/coverage/

# AppleDouble / dot-underscore scratch files (e.g. transient auth-render scripts) —
# defensive net so a stray `git add` can't sweep local scratch into history
._*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript
*.tsbuildinfo
next-env.d.ts
.tmp-*.json

# C.A.R.E extension store build artifact
extension/store/dist/
extension/store/*.zip

# Extension download package — built fresh by prebuild (scripts/build-extension-download.mjs)
public/care-extension.zip

# Transient screenshots pasted into .claude/ (not project assets)
.claude/*.png

# Founder IP — never commit (untracked local reference only)
Thinkerthinker Build Key. MD.txt
/Thinkerthinker*.txt

# Live pilot access codes — never commit
PILOT-ACCESS-CODES.pdf
