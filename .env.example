# Copy this file to .env.local and fill in your values
# Never commit .env.local to GitHub

# LLM provider — DeepSeek is primary (AMD-003). Anthropic is the configurable alternate.
# At least one must be set. LLM_PROVIDER overrides auto-selection.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
# LLM_PROVIDER=deepseek

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Sentry (error monitoring) — optional but recommended before
# pilot customers. Without these, the SDK initializes to a no-op
# and the app behaves identically to a non-Sentry build.
# Get DSN from https://sentry.io → Project → Settings → Client Keys
# Get auth token from Sentry → Settings → Auth Tokens (for source
# map upload during build; only set on Vercel, not locally needed).
# NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
