# Copy this file to .env.local and fill in your values
# Never commit .env.local to GitHub

# LLM provider — DeepSeek is primary (AMD-003). Anthropic is the configurable alternate.
# At least one must be set. LLM_PROVIDER overrides auto-selection.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL — leave UNSET to use the code default (deepseek-v4-flash).
# ⚠️ Do NOT set this to "deepseek-chat" — DeepSeek RETIRED that name 2026-07-25; the
# API now 400s on it and it takes down EVERY AI tool. If you override, use a current
# model id (deepseek-v4-flash / deepseek-v4-pro).
# DEEPSEEK_MODEL=deepseek-v4-flash
# ANTHROPIC_API_KEY — set this to enable cross-provider FAILOVER: if DeepSeek has an
# auth/quota/renamed-model failure, calls cascade to Anthropic instead of all AI going
# down. With only DeepSeek configured there is NO fallback (single point of failure).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=deepseek

# 🔒 Extension token-handoff pin (SECURITY, set in PRODUCTION). The /extension/connect
# page hands the signed-in user's session token to the extension. When this is UNSET it
# fail-opens — handing the token to ANY extension id supplied in the URL (a token-theft
# vector). Set it to the official Chrome Web Store extension id in production so the
# handoff only ever targets your extension.
# NEXT_PUBLIC_CARE_EXTENSION_ID=

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ElevenLabs — required for Jeff's voice mode (real-time
# conversation in the customer widget). Without this, the
# /api/care/tts and /api/care/stt endpoints return 500 and the
# widget mic button shows an error to the customer; everything
# else (text chat, Coach, Co-Pilot) keeps working.
# Get the key from elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
# Optional override for the deployment-wide default voice.
# Defaults to Antoni (ErXwobaYiN019PkySvjV) when unset. Per-
# tenant overrides happen via the widget settings UI — this is
# the fallback when a tenant hasn't picked one.
# ELEVENLABS_DEFAULT_VOICE_ID=

# Sentry (error monitoring) — optional but recommended before
# pilot customers. Without these, the SDK initializes to a no-op
# and the app behaves identically to a non-Sentry build.
# Get DSN from https://sentry.io → Project → Settings → Client Keys
# Get auth token from Sentry → Settings → Auth Tokens (for source
# map upload during build; only set on Vercel, not locally needed).
# NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Migration apply (scripts/db-apply.mjs) ---
# Preferred: paste the one-line "Session pooler" string (IPv4) from Supabase dashboard
#   → Settings → Database → Connection string → Session pooler. Includes host/region/port/password.
# If unset, db-apply constructs the DIRECT connection from SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD
# (IPv6-only on most projects; may not route from Windows).
SUPABASE_DB_URL=
