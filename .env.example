# Copy this file to .env.local and fill in your values
# Never commit .env.local to GitHub

# LLM provider — DeepSeek is primary (AMD-003). Anthropic is the configurable alternate.
# At least one must be set. LLM_PROVIDER overrides auto-selection.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL — leave UNSET to use the code default (deepseek-v4-flash).
# ⚠️ Do NOT set this to "deepseek-chat" — DeepSeek RETIRED that name 2026-07-25; the
# API now 400s on it and it takes down EVERY AI tool. If you override, use a current
# model id (deepseek-v4-flash / deepseek-v4-pro).
# DEEPSEEK_MODEL=deepseek-v4-flash
# ANTHROPIC_API_KEY — set this to enable cross-provider FAILOVER: if DeepSeek has an
# auth/quota/renamed-model failure, calls cascade to Anthropic instead of all AI going
# down. With only DeepSeek configured there is NO fallback (single point of failure).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=deepseek

# 🔒 Extension token-handoff pin (SECURITY, set in PRODUCTION). The /extension/connect
# page hands the signed-in user's session token to the extension. When this is UNSET it
# fail-opens — handing the token to ANY extension id supplied in the URL (a token-theft
# vector). Set it to the official Chrome Web Store extension id in production so the
# handoff only ever targets your extension.
# NEXT_PUBLIC_CARE_EXTENSION_ID=
# Same, for the Sales Coach extension — /extension/connect?product=sales pins the token handoff to this id.
# NEXT_PUBLIC_SALES_EXTENSION_ID=

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ElevenLabs — required for Jeff's voice mode (real-time
# conversation in the customer widget). Without this, the
# /api/care/tts and /api/care/stt endpoints return 500 and the
# widget mic button shows an error to the customer; everything
# else (text chat, Coach, Co-Pilot) keeps working.
# Get the key from elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
# Optional override for the deployment-wide default voice.
# Defaults to Antoni (ErXwobaYiN019PkySvjV) when unset. Per-
# tenant overrides happen via the widget settings UI — this is
# the fallback when a tenant hasn't picked one.
# ELEVENLABS_DEFAULT_VOICE_ID=

# Sentry (error monitoring) — optional but recommended before
# pilot customers. Without these, the SDK initializes to a no-op
# and the app behaves identically to a non-Sentry build.
# Get DSN from https://sentry.io → Project → Settings → Client Keys
# Get auth token from Sentry → Settings → Auth Tokens (for source
# map upload during build; only set on Vercel, not locally needed).
# NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Migration apply (scripts/db-apply.mjs) ---
# Preferred: paste the one-line "Session pooler" string (IPv4) from Supabase dashboard
#   → Settings → Database → Connection string → Session pooler. Includes host/region/port/password.
# If unset, db-apply constructs the DIRECT connection from SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD
# (IPv6-only on most projects; may not route from Windows).
SUPABASE_DB_URL=

# ── Demo pages (/care/demo, /sales/demo) ──────────────────────────────────────
# The "Book a call" / contact CTA on the prospect demo pages. Set this to your real booking or contact
# link (Calendly, a mailto:, your marketing site, etc.). Falls back to /login until set. NEXT_PUBLIC_ vars
# are inlined at BUILD time, so set it in Vercel and redeploy for it to take effect.
NEXT_PUBLIC_BOOKING_URL=

# ── Supabase service role (SERVER-ONLY, required) ─────────────────────────────
# The service-role key from Settings → API. The admin client uses it and it BYPASSES RLS, so it must
# NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix). Required for the whole service-role surface:
# crons, the extension auth gate, inbound email, RCD ingest, admin writes. Missing → those 500.
SUPABASE_SERVICE_ROLE_KEY=

# ── Background jobs / crons (required to turn the cron layer on) ───────────────
# One shared Bearer secret gates every SCHEDULED cron in vercel.json: the hourly durability sweep
# (the §3.5 "did the fix hold?" moat metric — silently inert without this), backfill-dissects,
# task-overrun-sweep-cron, and finance/reports/deliver-cron. Set the SAME strong random value here and in
# Vercel; Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`. Unset → every cron
# route returns 503 (disabled). (The dormant RCD-retention + recording-purge crons also use this secret
# once you add them to vercel.json.)
CRON_SECRET=
# Optional MANUAL-trigger secrets (advanced/operator use). The two sweep jobs also expose a POST endpoint
# for forcing a run OFF-schedule (e.g. testing) — these gate those, sent as the `x-care-sweep-secret` /
# matching header. The SCHEDULED crons above do NOT need them (they use CRON_SECRET via Vercel). Unset →
# only the manual POST endpoints are disabled (503); the scheduled runs are unaffected.
# CARE_DURABILITY_SWEEP_SECRET=
# TASK_OVERRUN_SWEEP_SECRET=

# ── Web push notifications (optional) ─────────────────────────────────────────
# Generate a keypair once: `npx web-push generate-vapid-keys`. Without all three, push SUBSCRIPTIONS
# succeed but nothing is delivered. VAPID_SUBJECT is a mailto: or https URL identifying the sender.
VAPID_SUBJECT=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Email channel (optional — enables C.A.R.E email support) ───────────────────
# POSTMARK_SERVER_TOKEN: the Postmark server token for SENDING replies. Without it, the app logs and sends
# nothing (email replies are skipped).
POSTMARK_SERVER_TOKEN=
# CARE_INBOUND_EMAIL_SECRET: shared secret for the INBOUND-email webhook. Set the SAME value in Postmark's
# inbound webhook config as the `X-Care-Webhook-Secret` header. Unset → the webhook fail-closes (500) so a
# misconfig can never accept a forged email. (See src/app/api/care/inbound/email/route.ts.)
CARE_INBOUND_EMAIL_SECRET=
# CARE_EMAIL_HOST_DOMAIN: the domain your C.A.R.E support addresses live on (e.g. support.yourco.com).
CARE_EMAIL_HOST_DOMAIN=

# ── Raw Conversation Data (RCD) retention (optional) ──────────────────────────
# Days to keep extension-captured conversations before the retention cron purges them (default 90). A
# value of 0/negative/non-numeric SAFELY falls back to 90 — it can never mass-delete. Activating the purge
# also needs CRON_SECRET (above) + a vercel.json cron entry (it deletes customer PII — a conscious step).
RCD_RETENTION_DAYS=

# ── Misc ──────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL: canonical origin used by robots.txt + sitemap.xml (SEO). Defaults to
# http://localhost:4321 when unset; set it to your production URL so the sitemap/robots are correct.
NEXT_PUBLIC_SITE_URL=
# CARE_DEFAULT_TENANT_ID: overrides which tenant id is treated as "our own" (Jeff's authoritative product
# knowledge + the demo). Leave UNSET to use the built-in ELOSTATE id; set it only if your own workspace
# uses a different company id.
CARE_DEFAULT_TENANT_ID=
# ANTHROPIC_MODEL: override the Anthropic model name. Leave UNSET to use the code default.
# ANTHROPIC_MODEL=
