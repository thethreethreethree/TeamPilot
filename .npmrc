# Refuse to install on a Node below the floor in package.json, rather than warn.
#
# WHY THIS FILE EXISTS. On 4 September CI went red with 25 identical errors --
# every jsdom worker dying on `webidl.util.markAsUncloneable is not a function`
# -- because the runner was on Node 20 while jsdom@30 requires 22+ and undici@8
# requires 22.19+. Not one assertion ran in those files, 4,028 tests passed
# around them, and it read as a test failure for as long as it took to open the
# dependency tree.
#
# npm knows how to prevent that. Without engine-strict it only WARNS, and a
# warning in a wall of npm output is missed every time; with it, the install
# stops and names the version it wants. The failure moves from an hour into CI
# to the first command anyone runs.
#
# The cost is real and deliberate: someone on a different Node MAJOR is BLOCKED
# rather than inconvenienced. That is the trade the founder chose on 4 September.
#
# The pin is "24.x", an exact major rather than ">=24", because the point is to
# kill drift and ">=" permits the next silent divergence. It matches production:
# FOUNDER-ACTION-QUEUE recorded on 2026-08-02, from the live /api/health, that
# Vercel builds and runs on 24 while CI tested on 20. That entry prescribed this
# exact fix -- pin engines.node to 24.x, bump CI to 24 -- and this is it.
engine-strict=true
