{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"
            ],
            "timeout": 20,
            "statusMessage": "Loading design system status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/law-session-start.mjs"
            ],
            "timeout": 45,
            "statusMessage": "Loading governing law"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/autonomous-session-notice.mjs"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-anchor.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/law-prompt-anchor.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-write-guard.mjs"
            ],
            "timeout": 45,
            "statusMessage": "Checking design rules"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/law-read-gate.mjs"
            ],
            "timeout": 20,
            "statusMessage": "Checking the governing law"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-write-lint.mjs"
            ],
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/law-read-record.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.mjs"
            ],
            "timeout": 240,
            "statusMessage": "Running the design gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/build-continue-guard.mjs"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node tools/design-lint.mjs:*)",
      "Bash(node tools/token-gen.mjs:*)",
      "Bash(node tools/contrast-audit.mjs:*)",
      "Bash(node tools/runtime-audit.mjs:*)",
      "Bash(node tools/gate.mjs:*)",
      "Read(//**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./00-START-HERE.md)",
      "Edit(./00-START-HERE.md)",
      "Write(./01-CONSTITUTION.md)",
      "Edit(./01-CONSTITUTION.md)",
      "Write(./03-ANTI-FAULT.md)",
      "Edit(./03-ANTI-FAULT.md)",
      "Write(./**/00-START-HERE.md)",
      "Edit(./**/00-START-HERE.md)",
      "Write(./**/01-CONSTITUTION.md)",
      "Edit(./**/01-CONSTITUTION.md)",
      "Write(./**/03-ANTI-FAULT.md)",
      "Edit(./**/03-ANTI-FAULT.md)",
      "Write(./tools/**)",
      "Edit(./tools/**)",
     
      
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)"
    ],
    "ask": [
      "Write(./tools/**)",
      "Edit(./tools/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Bash(rm:*tools*)",
      "Bash(mv:*tools*)"
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
