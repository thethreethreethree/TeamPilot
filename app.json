{
  "expo": {
    "name": "Elostate Coach",
    "slug": "Elostate-Sales-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elostatesalescoach",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.elostate.salescoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleName": "Elostate Coach",
        "CFBundleDisplayName": "Elostate Coach",
        "NSMicrophoneUsageDescription": "Elostate records your sales calls so they can be transcribed and coached. Recording only starts when you press record, and you can stop it at any time.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.elostate.salescoach",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#09090B"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Elostate records your sales calls so they can be transcribed and coached. Recording only starts when you press record, and you can stop it at any time."
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4c83bd4-5718-4fb4-9701-8189f945add4"
      }
    },
    "owner": "elostate-tech"
  }
}
